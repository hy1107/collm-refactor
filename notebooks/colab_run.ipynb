   "source": [
    "# CoLLM Injection Layer Experiment\n",
    "\n",
    "**流程：**\n",
    "1. 確認 GPU\n",
    "2. 掛載 Google Drive（存 checkpoint 和資料）\n",
    "3. Clone repo、安裝套件\n",
    "4. 下載並預處理 ML-1M\n",
    "5. 訓練 Rec Encoder（SASRec）\n",
    "6. Stage 1：LoRA fine-tune\n",
    "7. Stage 2：不同 injection layer sweep\n",
    "\n",
    "**GPU 需求：**\n",
    "| GPU | 建議設定 |\n",
    "|-----|----------|\n",
    "| T4 (16GB) | `load_in_8bit: true`，batch=2 |\n",
    "| A100 (40GB) | fp16，batch=4 |"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 1：確認 GPU ────────────────────────────────────────\n",
    "import subprocess\n",
    "result = subprocess.run(['nvidia-smi', '--query-gpu=name,memory.total', '--format=csv,noheader'],\n",
    "                        capture_output=True, text=True)\n",
    "print('GPU:', result.stdout.strip())\n",
    "\n",
    "import torch\n",
    "print('CUDA available:', torch.cuda.is_available())\n",
    "if torch.cuda.is_available():\n",
    "    print('Device:', torch.cuda.get_device_name(0))\n",
    "    vram_gb = torch.cuda.get_device_properties(0).total_memory / 1e9\n",
    "    print(f'VRAM: {vram_gb:.1f} GB')\n",
    "    USE_8BIT = vram_gb < 20  # T4 用 8bit，A100 用 fp16\n",
    "    print(f'load_in_8bit: {USE_8BIT}')\n",
    "else:\n",
    "    USE_8BIT = False"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 2：掛載 Google Drive ───────────────────────────────\n",
    "from google.colab import drive\n",
    "drive.mount('/content/drive')\n",
    "\n",
    "import os\n",
    "BASE = '/content/drive/MyDrive/collm_experiment'\n",
    "os.makedirs(BASE, exist_ok=True)\n",
    "DATA_DIR   = f'{BASE}/data/ml-1m'\n",
    "CKPT_DIR   = f'{BASE}/checkpoints'\n",
    "os.makedirs(DATA_DIR, exist_ok=True)\n",
    "os.makedirs(CKPT_DIR, exist_ok=True)\n",
    "print('Base directory:', BASE)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 3：Clone repo 並安裝套件 ───────────────────────────\n",
    "import os\n",
    "REPO_DIR = '/content/collm-refactor'\n",
    "\n",
    "if not os.path.exists(REPO_DIR):\n",
    "    !git clone https://github.com/hy1107/collm-refactor.git {REPO_DIR}\n",
    "else:\n",
    "    !cd {REPO_DIR} && git pull\n",
    "\n",
    "# 安裝套件（bitsandbytes 是 8bit 量化必要套件）\n",
    "!pip install -q -e {REPO_DIR}\n",
    "!pip install -q bitsandbytes accelerate\n",
    "\n",
    "%cd {REPO_DIR}\n",
    "print('Working directory:', os.getcwd())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 4：下載 ML-1M 資料集 ───────────────────────────────\n",
    "import os\n",
    "\n",
    "RAW_DIR = DATA_DIR  # /content/drive/MyDrive/collm_experiment/data/ml-1m\n",
    "\n",
    "if not os.path.exists(f'{RAW_DIR}/ratings.dat'):\n",
    "    !wget -q -O /tmp/ml-1m.zip https://files.grouplens.org/datasets/movielens/ml-1m.zip\n",
    "    !unzip -q /tmp/ml-1m.zip -d /tmp/\n",
    "    !cp /tmp/ml-1m/ratings.dat {RAW_DIR}/\n",
    "    !cp /tmp/ml-1m/movies.dat  {RAW_DIR}/\n",
    "    !cp /tmp/ml-1m/users.dat   {RAW_DIR}/\n",
    "    print('ML-1M 下載完成')\n",
    "else:\n",
    "    print('ML-1M 已存在，跳過下載')\n",
    "\n",
    "!ls -lh {RAW_DIR}/"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 5：預處理資料 ──────────────────────────────────────\n",
    "import os\n",
    "\n",
    "if not os.path.exists(f'{DATA_DIR}/train.pkl'):\n",
    "    !python scripts/preprocess_ml1m.py \\\n",
    "        --data_dir   {DATA_DIR} \\\n",
    "        --output_dir {DATA_DIR} \\\n",
    "        --neg_per_pos 1\n",
    "else:\n",
    "    print('預處理資料已存在，跳過')\n",
    "\n",
    "import pandas as pd\n",
    "for split in ['train', 'valid', 'test']:\n",
    "    df = pd.read_pickle(f'{DATA_DIR}/{split}.pkl')\n",
    "    print(f'{split}: {len(df)} 筆，欄位: {list(df.columns)}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 6：訓練 Rec Encoder（SASRec）──────────────────────\n",
    "import os\n",
    "\n",
    "REC_CKPT = f'{CKPT_DIR}/sasrec_ml1m.pth'\n",
    "\n",
    "if not os.path.exists(REC_CKPT):\n",
    "    !python scripts/train_rec_encoder.py \\\n",
    "        --data_path   {DATA_DIR}/train \\\n",
    "        --encoder_type sasrec \\\n",
    "        --embedding_dim 64 \\\n",
    "        --n_layers 2 \\\n",
    "        --n_heads 2 \\\n",
    "        --max_seq_len 50 \\\n",
    "        --epochs 30 \\\n",
    "        --lr 1e-3 \\\n",
    "        --batch_size 256 \\\n",
    "        --save_path {REC_CKPT}\n",
    "else:\n",
    "    print(f'Rec encoder 已存在：{REC_CKPT}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 7：更新 YAML 設定（路徑 + 8bit）──────────────────\n",
    "import yaml, os\n",
    "\n",
    "# Stage 1 config\n",
    "with open('configs/stage1_movielens.yaml') as f:\n",
    "    cfg1 = yaml.safe_load(f)\n",
    "cfg1['data']['data_path'] = DATA_DIR\n",
    "cfg1['backbone']['load_in_8bit'] = bool(USE_8BIT)\n",
    "with open('configs/stage1_movielens.yaml', 'w') as f:\n",
    "    yaml.dump(cfg1, f, allow_unicode=True)\n",
    "\n",
    "# Stage 2 config\n",
    "with open('configs/stage2_movielens.yaml') as f:\n",
    "    cfg2 = yaml.safe_load(f)\n",
    "cfg2['data']['data_path']          = DATA_DIR\n",
    "cfg2['rec']['checkpoint_path']     = f'{CKPT_DIR}/sasrec_ml1m.pth'\n",
    "cfg2['backbone']['load_in_8bit']   = bool(USE_8BIT)\n",
    "with open('configs/stage2_movielens.yaml', 'w') as f:\n",
    "    yaml.dump(cfg2, f, allow_unicode=True)\n",
    "\n",
    "print('Stage 1 config:')\n",
    "!cat configs/stage1_movielens.yaml\n",
    "print()\n",
    "print('Stage 2 config:')\n",
    "!cat configs/stage2_movielens.yaml"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 8：Stage 1 — LoRA fine-tune ───────────────────────\n",
    "# ⚠️  T4 上約需 2-3 小時（3 epochs），A100 約 40 分鐘\n",
    "import os\n",
    "\n",
    "STAGE1_CKPT = f'{CKPT_DIR}/stage1'\n",
    "\n",
    "if not os.path.exists(f'{STAGE1_CKPT}/adapter_config.json'):\n",
    "    BS = 2 if USE_8BIT else 4\n",
    "    !python scripts/train_stage1.py \\\n",
    "        --config configs/stage1_movielens.yaml \\\n",
    "        --output_dir {STAGE1_CKPT} \\\n",
    "        --num_train_epochs 3 \\\n",
    "        --per_device_train_batch_size {BS} \\\n",
    "        --learning_rate 2e-4\n",
    "else:\n",
    "    print(f'Stage 1 checkpoint 已存在：{STAGE1_CKPT}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 9：Stage 2 — 單一 injection layer 快速測試 ─────────\n",
    "# 先跑 layer=0（原始 CoLLM）確認流程沒問題\n",
    "\n",
    "TEST_LAYER = 0\n",
    "BS = 2 if USE_8BIT else 4\n",
    "\n",
    "!python scripts/train_stage2.py \\\n",
    "    --config              configs/stage2_movielens.yaml \\\n",
    "    --stage1_checkpoint   {STAGE1_CKPT} \\\n",
    "    --output_dir          {CKPT_DIR}/stage2_layer{TEST_LAYER} \\\n",
    "    --injection_layer     {TEST_LAYER} \\\n",
    "    --num_train_epochs    1 \\\n",
    "    --per_device_train_batch_size {BS} \\\n",
    "    --learning_rate       1e-4"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 10：Stage 2 — 多 layer sweep ──────────────────────\n",
    "# ⚠️  每個 layer 跑 2 epochs，共 6 組，T4 上約需 6-8 小時\n",
    "# 建議在 Colab Pro / A100 上執行\n",
    "\n",
    "LAYERS = [0, 3, 10, 16, 20, 23]\n",
    "BS = 2 if USE_8BIT else 4\n",
    "\n",
    "import subprocess, json\n",
    "\n",
    "results = []\n",
    "\n",
    "for layer in LAYERS:\n",
    "    out_dir = f'{CKPT_DIR}/stage2_layer{layer}'\n",
    "    print(f'\\n====== injection_layer={layer} ======')\n",
    "    ret = subprocess.run(\n",
    "        ['python', 'scripts/train_stage2.py',\n",
    "         '--config',                      'configs/stage2_movielens.yaml',\n",
    "         '--stage1_checkpoint',            STAGE1_CKPT,\n",
    "         '--output_dir',                   out_dir,\n",
    "         '--injection_layer',              str(layer),\n",
    "         '--num_train_epochs',             '2',\n",
    "         '--per_device_train_batch_size',  str(BS),\n",
    "         '--learning_rate',               '1e-4'],\n",
    "        capture_output=False\n",
    "    )\n",
    "    results.append({'layer': layer, 'output_dir': out_dir,\n",
    "                    'returncode': ret.returncode})\n",
    "\n",
    "print('\\n====== Sweep 結果 ======')\n",
    "for r in results:\n",
    "    status = 'OK' if r['returncode'] == 0 else 'FAILED'\n",
    "    print(f\"  layer={r['layer']:2d}  {status}  →  {r['output_dir']}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 11：比較各 layer 的 eval metrics ──────────────────\n",
    "import os, json\n",
    "import pandas as pd\n",
    "\n",
    "LAYERS = [0, 3, 10, 16, 20, 23]\n",
    "rows = []\n",
    "\n",
    "for layer in LAYERS:\n",
    "    trainer_state = f'{CKPT_DIR}/stage2_layer{layer}/trainer_state.json'\n",
    "    if not os.path.exists(trainer_state):\n",
    "        continue\n",
    "    with open(trainer_state) as f:\n",
    "        state = json.load(f)\n",
    "    # 取最後一個 eval log\n",
    "    eval_logs = [x for x in state.get('log_history', []) if 'eval_auc' in x]\n",
    "    if eval_logs:\n",
    "        last = eval_logs[-1]\n",
    "        rows.append({\n",
    "            'injection_layer': layer,\n",
    "            'auc':    round(last.get('eval_auc',    0), 4),\n",
    "            'hr@10':  round(last.get('eval_hr@10',  0), 4),\n",
    "            'ndcg@10':round(last.get('eval_ndcg@10',0), 4),\n",
    "        })\n",
    "\n",
    "if rows:\n",
    "    df = pd.DataFrame(rows).set_index('injection_layer')\n",
    "    print(df.to_string())\n",
    "    df.to_csv(f'{CKPT_DIR}/sweep_results.csv')\n",
    "    print(f'\\n結果已存至 {CKPT_DIR}/sweep_results.csv')\n",
    "else:\n",
    "    print('尚無 eval 結果，請先完成 Cell 10 的 sweep')"
   ]
  }
 ]
}"
